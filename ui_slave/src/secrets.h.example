// Copy this file to `secrets.h` and fill in your WiFi credentials.
// `secrets.h` is gitignored; the example is the only template that ships.
//
// At runtime the slave first tries credentials saved in NVS (entered via the
// touchscreen WiFi screen or the captive-portal web UI). If those are empty
// it falls back to SECRET_SSID / SECRET_PASS below. If both are empty or the
// connection fails it starts SoftAP "OpenChessUI-XXXX" for first-time setup.

#ifndef UI_SLAVE_SECRETS_H
#define UI_SLAVE_SECRETS_H

#define SECRET_SSID ""
#define SECRET_PASS ""

#endif // UI_SLAVE_SECRETS_H
